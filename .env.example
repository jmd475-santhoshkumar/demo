# Read by `docker compose` (same directory as docker-compose.yml).
# Template -- copy to .env and fill in. Safe to commit.

# ── Database ──────────────────────────────────────────────────────────────
# Postgres runs as a container (see docker-compose.yml). These three create
# the role + database on the FIRST start only -- fill them in before the
# first "docker compose up", or you must wipe ./db/data to change them.
# Keep the password hex/alphanumeric: it is embedded in DATABASE_URL below,
# where @ : / ? # would need URL-encoding and silently break the connection.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Must match the three values above. Host is "postgres" -- the compose
# service name, resolved over the internal network, NOT localhost.
#   postgresql+psycopg2://<POSTGRES_USER>:<POSTGRES_PASSWORD>@postgres:5432/<POSTGRES_DB>
# For RDS instead, replace the host with the RDS endpoint.
DATABASE_URL=

# ── Public URLs -- REPLACE <EC2_PUBLIC_IP> before deploying ────────────────
CORS_ORIGINS=http://<EC2_PUBLIC_IP>
FRONTEND_URL=http://<EC2_PUBLIC_IP>

# ── Data source ────────────────────────────────────────────────────────────
DATA_SOURCE_MODE=local
JIN_API_BASE_URL=
JIN_API_KEY=

# ── Email / daily digest ───────────────────────────────────────────────────
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USERNAME=
MAILTRAP_PASSWORD=
MAILTRAP_FROM_EMAIL=resourceiq@jmangroup.com
MAILTRAP_FROM_NAME=ResourceIQ
DIGEST_RECIPIENT_EMAIL=

# ── Pinecone ───────────────────────────────────────────────────────────────
PINECONE_API_KEY=
PINECONE_HOST=

# ── Azure DevOps ───────────────────────────────────────────────────────────
AZURE_DEVOPS_ORG=jmangroupltd
AZURE_DEVOPS_PROJECT=managed-services
AZURE_DEVOPS_TEAM=UPR_009 upReach - Product Maintenance
AZURE_DEVOPS_PAT=

# ── LLM providers (first one configured wins: Azure OpenAI > Gemini > Claude)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ── Entra ID SSO (all blank => SSO disabled, app runs unauthenticated) ─────
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_REDIRECT_URI=
# Generate with: openssl rand -hex 32
SESSION_SECRET_KEY=

# ── S3 attachment uploads (blank => uploads fall back to local handling) ───
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-north-1
S3_ATTACHMENTS_BUCKET=
