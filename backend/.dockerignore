# Real data -- never baked into an image. All of this is meant to live on a
# mounted persistent volume at runtime (see DEPLOYMENT_PLAN.md section 3),
# seeded out-of-band, never shipped as an image layer.
data/Transformed/*.csv
data/Transformed/*.xlsx
data/AppState/jdwh_load_backups/
data/AppState/upload_backups/
data/AppState/resumes/
data/AppState/sow_uploads/
data/AppState/sow_converted_pdfs/
data/AppState/sow_extractions.json
data/AppState/document_imports.json
data/AppState/jdwh_connection.json
data/HeadcountPrediction/*.csv

# Real files that sit loose at the repo root outside git tracking -- a plain
# `COPY . .` would happily pick these up otherwise.
*.xlsx
*.ods
*.pdf
*.docx
*.pptx
Copy of Skills Matrix_(Sheet1).csv

# Local mutable caches -- regenerated by the app itself (embedding vectors
# are re-encoded once and then persisted on the same mounted volume as the
# real data above; a dev machine's copy is specific to that machine's data
# and shouldn't ship in the image).
.embedding_cache/
logs/
*.log

# Standard noise.
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.git/
.gitignore
.env
.env.*
.venv/
venv/
*.egg-info/

# Docs/scratch, not needed inside the running container.
*.md
.claude/
